# ========= MDP settings =========
@configclass
class CommandsCfg:
    locomotion = mdp.UniformVelocityCommandCfg(
        asset_name="robot",
        resampling_time_range=(4.0, 6.0),   # 重新采样时间
        heading_command=False,              
        rel_standing_envs=0.0,              
        rel_heading_envs=0.0,
        debug_vis=True,
        ranges=mdp.UniformVelocityCommandCfg.Ranges(
            lin_vel_x=(-0.8,0.8),#(-0.8, 0.8),
            lin_vel_y=(0.0, 0.0),          
            ang_vel_z=(-1.0,1.0),#(-1.0, 1.0),
            heading=(-math.pi, math.pi),  # 朝向
        ),
    )
        
    ee_goal = EeSphericalGoalCommandCfg(
        asset_name="robot",
        traj_time=(1.0, 3.0),
        hold_time=(0.5, 2.0),
        pos_l=(0.5, 0.7),  # r
        pos_p=(-math.pi / 4, 0.0),  # 俯仰
        # pos_y=(-0.5, 0.5),  # 偏航
        # sphere_center_base=(-0.215, 0.0, 0.805),
        debug_vis=True,
    )


@configclass
class ActionsCfg:
    # --- policy actions (12) : legs ---
    leg_pos = mdp.JointPositionActionCfg(
        asset_name="robot",
        joint_names=[
            "FR_hip_joint", "FR_thigh_joint", "FR_calf_joint",
            "FL_hip_joint", "FL_thigh_joint", "FL_calf_joint",
            "RR_hip_joint", "RR_thigh_joint", "RR_calf_joint",
            "RL_hip_joint", "RL_thigh_joint", "RL_calf_joint",
        ],
        scale={
            ".*_hip_.*": 0.4,
            ".*_thigh_.*": 0.45,
            ".*_calf_.*": 0.45,
        },                        # VBC 的 action_scale=[0.4, 0.45, 0.45] * 2 + [0.4, 0.45, 0.45] * 2 + [2.1, 0.6, 0.6, 0, 0, 0]
        use_default_offset=True,  # offset = default joint angles from asset
    )
    # --- policy actions (4) : wheels ---
    wheel_vel = mdp.JointVelocityActionCfg(
        asset_name="robot",
        joint_names=["FL_foot_wheel_joint", "FR_foot_wheel_joint", "RL_foot_wheel_joint", "RR_foot_wheel_joint"],
        scale=0.1,
        use_default_offset=False,
        preserve_order=True,
    )

    # --- internal controller (0) : arm IK from ee_goal command ---
    arm_ik = ArmIkFromEeGoalActionCfg(   # 自定义的 cfg/class
        asset_name="robot",
        command_name="ee_goal",              # 对应 CommandsCfg.ee_goal 字段名
        ee_body_name="link6",         # 实际在mdp/actions和mdp/commands中这个ee->link6,然后再做tcp
        arm_joint_names=["joint1", "joint2", "joint3", "joint4", "joint5", "joint6"],
        damping=0.05,                        # VBC 的 lambda=(0.05^2)
    )
    


@configclass
class ObservationsCfg:
    @configclass
    class PolicyCfg(ObsGroup):
        obs = ObsTerm(
            func=VbcPolicyObsTerm,
            params={
                "asset_name": "robot",
                # 12腿+4轮+6臂，不含 joint_7/8
                "obs_joint_names": [
                    "FR_hip_joint","FR_thigh_joint","FR_calf_joint",
                    "FL_hip_joint","FL_thigh_joint","FL_calf_joint",
                    "RR_hip_joint","RR_thigh_joint","RR_calf_joint",
                    "RL_hip_joint","RL_thigh_joint","RL_calf_joint",
                    "FL_foot_wheel_joint","FR_foot_wheel_joint","RL_foot_wheel_joint","RR_foot_wheel_joint",
                    "joint1","joint2","joint3","joint4","joint5","joint6",
                ],
                # body 
                "contact_body_names": ["FL_foot", "FR_foot", "RL_foot", "RR_foot"],
                "history_len": 10,
                "use_priv": True,
                "arm_base_offset": (-0.3, 0.0, 0.09),
            },
        )

        def __post_init__(self):
            self.enable_corruption = False
            self.concatenate_terms = True

    policy: PolicyCfg = PolicyCfg()


@configclass
class EventCfg:
    # 1) reset root（把 base 位置/朝向/速度重置）
    reset_root = EventTerm(
        func=mdp.reset_root_state_uniform,
        mode="reset",
        params={
            "asset_cfg": SceneEntityCfg("robot"),
            # x/y 小扰动 + yaw 随机
            "pose_range": {"x": (-0.5, 0.5), "y": (-0.5, 0.5), "yaw": (-math.pi, math.pi)},
            # 速度小扰动
            "velocity_range": {
                "x": (0.0, 0.0),
                "y": (0.0, 0.0),
                "z": (0.0, 0.0),
                "roll": (0.0, 0.0),
                "pitch": (0.0, 0.0),
                "yaw": (0.0, 0.0),
            },
        },
    )
    # 2) reset joints（把所有关节位置/速度重置到 default + 小扰动）
    reset_joints = EventTerm(
        func=mdp.reset_joints_by_offset,
        mode="reset",
        params={
            "asset_cfg": SceneEntityCfg("robot"),  # joint_names=None 默认就是全部关节
            "position_range": (-0.02, 0.02),
            "velocity_range": (0.0, 0.0),
        },
    )

    # 3) reset 时初始化 priv buffer
    init_priv = EventTerm(func=set_vbc_priv_buf, mode="reset", params={"dim": 18})

    # 4) reset 时重置 reward buffer
    reset_rewards = EventTerm(
        func=reset_reward_buffers,
        mode="reset",
        params={"feet_count": 4},
    )

    # push / 8s 
    # push = EventTerm(
    #     func=mdp_core.push_by_setting_velocity,
    #     mode="interval",
    #     interval_range_s=(8.0, 8.0),
    #     params={
    #         "asset_cfg": SceneEntityCfg("robot"),
    #         "velocity_range": {"x": (-0.5, 0.5), "y": (-0.5, 0.5)},
    #     },
    # )


# ---------- bodies terms definition ----------
LEG_JOINTS = [
    "FR_hip_joint","FR_thigh_joint","FR_calf_joint",
    "FL_hip_joint","FL_thigh_joint","FL_calf_joint",
    "RR_hip_joint","RR_thigh_joint","RR_calf_joint",
    "RL_hip_joint","RL_thigh_joint","RL_calf_joint",
]
WHEEL_JOINTS = ["FL_foot_wheel_joint","FR_foot_wheel_joint","RL_foot_wheel_joint","RR_foot_wheel_joint"]
BASE_JOINTS = LEG_JOINTS + WHEEL_JOINTS   # 底盘=腿+轮
ARM_JOINTS = ["joint1","joint2","joint3","joint4","joint5","joint6"]

LEG_BODIES = [#'FL_hip', 'FR_hip', 'RL_hip', 'RR_hip', #'trunk',
    # "FL_thigh", "FR_thigh", "RL_thigh", "RR_thigh",  # 大腿
    # "FL_calf", "FR_calf", "RL_calf", "RR_calf",  # 小腿
    # "FL_foot","FR_foot","RL_foot","RR_foot",
    
]

# LEG_BODIES = []
# ['FL_hip', 'FR_hip', 'RL_hip', 'RR_hip', ]
            #   'FL_thigh', 'FR_thigh', 'RL_thigh', 'RR_thigh',] 
            #   'FL_calf', 'FR_calf', 'RL_calf', 'RR_calf']
FEET_BODIES = ["FL_foot","FR_foot","RL_foot","RR_foot"]

@configclass
class RewardsCfg:
    # ----------- penalty for termination -----------
    term_bad_contact = RewTerm(
        func=rt.penalty_bad_contact,
        weight=0.0,
        params={
            "sensor_names": LEG_BODY_CONTACT_SENSORS + HARD_BODY_CONTACT_SENSORS,
            "thresh": 10.0,
        },
    )

    term_tilt = RewTerm(
        func=rt.penalty_tilt,
        weight=0.0,
        params={
            "asset_cfg": SceneEntityCfg("robot"),
            "limit": 0.6,
        },
    )

    term_low_height = RewTerm(
        func=rt.penalty_low_height,
        weight=0.0,
        params={
            "asset_cfg": SceneEntityCfg("robot"),
            "z_min": 0.22,
        },
    )

    # ----------- arm -----------
    tracking_ee_sphere = RewTerm(
        func=rt.tracking_ee_sphere, 
        weight=0.0,
        params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"}
    )

    tracking_ee_world  = RewTerm(
        func=rt.tracking_ee_world,  
        weight=0.0,
        params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"}
    )
    
    tracking_ee_sphere_walking  = RewTerm(func=rt.tracking_ee_sphere, weight=0.0,
                                          params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"})
    tracking_ee_sphere_standing = RewTerm(func=rt.tracking_ee_sphere, weight=0.0,
                                          params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"})


    tracking_ee_cart   = RewTerm(func=rt.tracking_ee_cart,   weight=0.0,
                                 params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"})
    tracking_ee_orn    = RewTerm(func=rt.tracking_ee_orn,    weight=0.0,
                                 params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"})
    tracking_ee_orn_ry = RewTerm(func=rt.tracking_ee_orn_ry, weight=0.0,
                                 params={"asset_name":"robot","ee_body_name":"link6","command_name":"ee_goal"})
    arm_energy_abs_sum = RewTerm(func=rt.arm_energy_abs_sum, weight=0.0,
                                 params={"asset_name":"robot","arm_joint_names": ARM_JOINTS})

    # --------- base/locomotion ---------
    hip_action_l2          = RewTerm(func=rt.hip_action_l2, weight=0.0, params={"hip_action_indices": (0, 3, 6, 9)})  # 先占位（VBC 用 actions[0,3,6,9]，你要严格我后面给专用实现）
    leg_energy_abs_sum     = RewTerm(func=rt.leg_energy_abs_sum,  weight=0.0, params={"asset_name":"robot","leg_joint_names": LEG_JOINTS})  # 先占位：严格版见后续
    leg_energy_sum_abs     = RewTerm(func=rt.leg_energy_sum_abs,  weight=0.0, params={"asset_name":"robot","leg_joint_names": LEG_JOINTS})
    leg_action_l2          = RewTerm(func=rt.leg_action_l2, weight=0.0, params={"leg_action_dim": 12})
    leg_energy             = RewTerm(func=rt.leg_energy,  weight=0.0, params={"asset_name":"robot","leg_joint_names": LEG_JOINTS})

    tracking_lin_vel       = RewTerm(func=rt.tracking_lin_vel,       weight=0.0)
    tracking_lin_vel_x_l1  = RewTerm(func=rt.tracking_lin_vel_x_l1,  weight=0.0)
    tracking_lin_vel_x_exp = RewTerm(func=rt.tracking_lin_vel_x_exp, weight=0.0, params={"tracking_sigma": 0.2})
    tracking_ang_vel_yaw_l1  = RewTerm(func=rt.tracking_ang_vel_yaw_l1,  weight=0.0)
    tracking_ang_vel_yaw_exp = RewTerm(func=rt.tracking_ang_vel_yaw_exp, weight=0.0, params={"tracking_sigma": 0.2})
    tracking_lin_vel_y_l2  = RewTerm(func=rt.tracking_lin_vel_y_l2,  weight=0.0)
    tracking_lin_vel_z_l2  = RewTerm(func=rt.tracking_lin_vel_z_l2,  weight=0.0)

    survive                = RewTerm(func=rt.survive, weight=0.0)
    
    foot_contacts_z = RewTerm(
        func=rt.foot_contacts_z,
        weight=0.0,
        params={"sensor_names": tuple(FOOT_CONTACT_SENSORS)},
    )

    torques                = RewTerm(func=rt.torques, weight=0.0,
                                     params={"asset_name":"robot","joint_names": BASE_JOINTS})  # wheels included
    energy_square          = RewTerm(func=rt.energy_square, weight=0.0,
                                     params={"asset_name":"robot","joint_names": BASE_JOINTS})
    tracking_lin_vel_y     = RewTerm(func=rt.tracking_lin_vel_y, weight=0.0, params={"tracking_sigma": 0.2})
    lin_vel_z              = RewTerm(func=rt.lin_vel_z,     weight=0.0)
    ang_vel_xy             = RewTerm(func=rt.ang_vel_xy,    weight=0.0)
    tracking_ang_vel       = RewTerm(func=rt.tracking_ang_vel, weight=0.0, params={"tracking_sigma": 0.2})
    work                   = RewTerm(func=rt.work, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})

    dof_acc                = RewTerm(func=rt.dof_acc, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})
    action_rate            = RewTerm(func=rt.action_rate, weight=0.0, params={"action_dim": 16})  # wheels included
    
    dof_pos_limits         = RewTerm(
        func=rt.dof_pos_limits, 
        weight=0.0, 
        params={
            "asset_cfg": SceneEntityCfg(
                "robot",
                joint_names=LEG_JOINTS,
                preserve_order=True,
            )
        })
    
    delta_torques          = RewTerm(func=rt.delta_torques, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})

    collision              = RewTerm(func=rt.collision, weight=0.0,
                                     params={"sensor_name":"contact_forces","asset_name":"robot","penalize_tokens":("thigh","calf","trunk")})

    stand_still            = RewTerm(func=rt.stand_still, weight=0.0, params={"asset_name":"robot","joint_names": LEG_JOINTS})
    walking_dof            = RewTerm(func=rt.walking_dof, weight=0.0, params={"asset_name":"robot","joint_names": LEG_JOINTS})

    hip_pos                = RewTerm(func=rt.hip_pos, weight=0.0, params={"asset_name":"robot"})

    feet_jerk = RewTerm(
        func=rt.feet_jerk,
        weight=0.0,
        params={"sensor_names": FOOT_CONTACT_SENSORS},
    )

    alive                  = RewTerm(func=rt.alive, weight=0.0)
  
    feet_drag = RewTerm(
        func=rt.feet_drag,
        weight=0.0,
        params={
            "asset_name": "robot",
            "feet_body_names": FEET_BODIES,
            "sensor_names": FOOT_CONTACT_SENSORS,
        },
    )


    # 柔和步态
    feet_contact_forces = RewTerm(
        func=rt.feet_contact_forces,
        weight=0.0,
        params={
            "max_contact_force": 40.0,
            "sensor_names": tuple(FOOT_CONTACT_SENSORS),
        },
    )

    orientation            = RewTerm(func=rt.orientation, weight=0.0, params={"asset_name":"robot"})
    roll                   = RewTerm(func=rt.roll, weight=0.0, params={"asset_name":"robot"})
    base_height            = RewTerm(func=rt.base_height, weight=0.0, params={"asset_name":"robot","base_height_target":0.55})

    orientation_walking    = RewTerm(func=rt.orientation_walking, weight=0.0, params={"asset_name":"robot"})
    orientation_standing   = RewTerm(func=rt.orientation_standing, weight=0.0, params={"asset_name":"robot"})
    torques_walking        = RewTerm(func=rt.torques_walking, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})
    torques_standing       = RewTerm(func=rt.torques_standing, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})
    energy_square_walking  = RewTerm(func=rt.energy_square_walking, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})
    energy_square_standing = RewTerm(func=rt.energy_square_standing, weight=0.0, params={"asset_name":"robot","joint_names": BASE_JOINTS})
    base_height_walking    = RewTerm(func=rt.base_height_walking, weight=0.0, params={"asset_name":"robot","base_height_target":0.55})
    base_height_standing   = RewTerm(func=rt.base_height_standing, weight=0.0, params={"asset_name":"robot","base_height_target":0.55})

    dof_default_pos        = RewTerm(func=rt.dof_default_pos, weight=0.0, params={"asset_name":"robot","joint_names": LEG_JOINTS})
    dof_error              = RewTerm(func=rt.dof_error,       weight=0.0, params={"asset_name":"robot","joint_names": LEG_JOINTS})

    tracking_lin_vel_max   = RewTerm(func=rt.tracking_lin_vel_max, weight=0.0, params={"vx_clip": 0.2})
    penalty_lin_vel_y      = RewTerm(func=rt.penalty_lin_vel_y,    weight=0.0, params={"wz_clip": 0.5})

    # 平正
    flat_orientation_l2 = RewTerm(
        func=rt.flat_orientation_l2,
        weight=0.0,
        params={"asset_name": "robot"},
    )

    # 四足接触时间l2
    air_time_variance = RewTerm(
        func=rt.air_time_variance_penalty_from_sensors,
        weight=0.0,
        params={"sensor_names": tuple(FOOT_CONTACT_SENSORS)},
    )

    # ---- gait (keep all terms) ----
    tracking_contacts_shaped_force = RewTerm(func=rt.tracking_contacts_shaped_force, weight=0.0, params={"cfg_flag": False})
    tracking_contacts_shaped_vel   = RewTerm(func=rt.tracking_contacts_shaped_vel,   weight=0.0, params={"cfg_flag": False})
   
    feet_height = RewTerm(
        func=rt.feet_height,
        weight=0.0,
        params={
            "asset_name": "robot",
            "feet_body_names": FEET_BODIES,
            "allfeet": True,
        },
    )
    
    feet_air_time = RewTerm(
        func=rt.feet_air_time,
        weight=0.0,
        params={
            "sensor_names": FOOT_CONTACT_SENSORS,
            "allfeet": True,
        },
    )
    

    # ---- MUST be last ----
   
    
    update_last_buffers = RewTerm(
        func=rt.update_last_buffers,
        weight=0.0,
        params={"sensor_names": tuple(FOOT_CONTACT_SENSORS)},
    )

    # ---- wheels ----
    wheel_idle_speed = RewTerm(
        func=rt.wheel_idle_speed,
        weight=0.0,
        params={
            "asset_name": "robot",
            "wheel_joint_names": WHEEL_JOINTS,
            "vx_clip": 0.2,
            "wz_clip": 0.5,
        },
    )

    wheel_action_l2 = RewTerm(
        func=rt.wheel_action_l2,
        weight=0.0,
        params={"wheel_action_slice": (12, 16)},
    )

    wheel_action_rate = RewTerm(
        func=rt.wheel_action_rate,
        weight=0.0,
        params={"wheel_action_slice": (12, 16)},
    )

    wheel_forward_use = RewTerm(
        func=rt.wheel_forward_use,
        weight=0.0,
        params={
            "asset_name": "robot",
            "wheel_joint_names": WHEEL_JOINTS,
            "wheel_radius": 0.11,       
            "wheel_dir_signs": (1.0, 1.0, 1.0, 1.0),  # 需要校准
            "tracking_sigma": 0.2,
            "vx_clip": 0.2,
            "wz_small": 0.35,
            "use_yaw_alignment_gate": True,
            "yaw_gate_sigma": 0.20,
        },
    )

    wheel_turn_support = RewTerm(
        func=rt.wheel_turn_support,
        weight=0.0,
        params={
            "asset_name": "robot",
            "wheel_joint_names": WHEEL_JOINTS,         # 顺序 FL,FR,RL,RR
            "wheel_radius": 0.11,                     
            "track_width": 0.5,                       # 左右轮中心距（米）
            "wheel_dir_signs": (1.0, 1.0, 1.0, 1.0),  
            "tracking_sigma": 0.2,
            "wz_clip": 0.35,
        },
    )
# ---------- Hyperparameters ---------- TODO：引用
HYPERPARAMS = dict(
    tracking_sigma=0.2,
    tracking_ee_sigma=1.0,#在rt中
    base_height_target=0.55,
    max_contact_force=40.0,
    gait_vel_sigma=0.5,#rt无
    gait_force_sigma=0.5,#rt无
    feet_height_target=0.3,#在rt中
)


scale_cfg = BaseScale()


@configclass
class TerminationsCfg:
    time_out = DoneTerm(func=mdp_core.time_out, time_out=True)

    bad_contact = DoneTerm(
        func=bad_contacts,
        params={
            "sensor_names": HARD_BODY_CONTACT_SENSORS,
            "thresh": 10.0,  # 阈值：接触力
        },
    )

    tilt = DoneTerm(func=base_tilt, params={"asset_cfg": SceneEntityCfg("robot"), "limit": 0.6})
    low_height = DoneTerm(func=base_height_low, params={"asset_cfg": SceneEntityCfg("robot"), "z_min": 0.2})



# ========= environment configuration =========

@configclass
class ManipLocoEnvCfg(ManagerBasedRLEnvCfg):
    scene: ManipLocoSceneCfg = ManipLocoSceneCfg(num_envs=1024, env_spacing=4.0)
    commands: CommandsCfg = CommandsCfg()
    actions: ActionsCfg = ActionsCfg()
    observations: ObservationsCfg = ObservationsCfg()
    events: EventCfg = EventCfg()
    rewards: RewardsCfg = RewardsCfg()
    terminations: TerminationsCfg = TerminationsCfg()

    def __post_init__(self):
        # robot prim_path
        self.scene.robot = ZYB_QUADRUPED_ARM_Cfg.replace(prim_path="{ENV_REGEX_NS}/Robot")

        # sim
        self.sim.dt = 1 / 120
        self.decimation = 4
        self.sim.render_interval = self.decimation

        # episode
        self.episode_length_s = 10.0

        # rewards 
        step_dt = self.sim.dt * self.decimation
        factor = 1.0 / (100.0 * step_dt)  

        all_scales = {}
        all_scales.update(scale_cfg.VBC_LOCO_SCALES)
        all_scales.update(scale_cfg.VBC_ARM_SCALES)
        all_scales.update(scale_cfg.WHEEL_SCALES)
        all_scales.update(scale_cfg.TERMINATION_SCALES)

        missing_terms = []
        for name, s in all_scales.items():
            if not hasattr(self.rewards, name):
                missing_terms.append(name)
                continue

            if s is None:
                setattr(self.rewards, name, None)
            else:
                getattr(self.rewards, name).weight = float(s) * factor

        print(f"======Missing terms====== \n{missing_terms}\n =======================")
            


# ========= PLAY ===========
@configclass
class ManipLocoPlayEnvCfg(ManipLocoEnvCfg):
    def __post_init__(self):
        super().__post_init__()

        self.scene.num_envs = 1
        self.scene.env_spacing = 4.0

        # play 时开可视化
        self.commands.ee_goal.debug_vis = True
        self.commands.locomotion.debug_vis = True

        # 一般 play 不要太强随机化
        # 你也可以保留 reset_root, 但先让它简单些
        self.events.reset_root.params["pose_range"] = {
            "x": (0.0, 0.0),
            "y": (0.0, 0.0),
            "yaw": (0.0, 0.0),
        }
        self.events.reset_root.params["velocity_range"] = {
            "x": (0.0, 0.0),
            "y": (0.0, 0.0),
            "z": (0.0, 0.0),
            "roll": (0.0, 0.0),
            "pitch": (0.0, 0.0),
            "yaw": (0.0, 0.0),
        }

        self.events.reset_joints.params["position_range"] = (0.0, 0.0)
        self.events.reset_joints.params["velocity_range"] = (0.0, 0.0)

        # play 可适当拉长 episode
        self.episode_length_s = 30.0



