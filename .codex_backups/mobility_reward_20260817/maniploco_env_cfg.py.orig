# ========= Scene Definition =========
@configclass
class ManipLocoSceneCfg(InteractiveSceneCfg):
    # --- 地形（用 TerrainImporterCfg，InteractiveScene 认识这个类型）
    terrain = TerrainImporterCfg(
        prim_path="/World/ground",
        terrain_type="plane",          # 平地
        terrain_generator=None,        # plane 必须是 None
        collision_group=-1,
        physics_material=sim_utils.RigidBodyMaterialCfg(
            static_friction=1.0,
            dynamic_friction=1.0,
            # restitution=0.0,
            friction_combine_mode="average",
            restitution_combine_mode="average",
        ),
        visual_material=sim_utils.MdlFileCfg(
            mdl_path=f"{ISAACLAB_NUCLEUS_DIR}/Materials/TilesMarbleSpiderWhiteBrickBondHoned/TilesMarbleSpiderWhiteBrickBondHoned.mdl",
            project_uvw=True,
            texture_scale=(0.25, 0.25),
        ),
        debug_vis=False,
    )

    # robot: EnvCfg中再设置
    robot: ArticulationCfg = MISSING

    # sensors
    # 高度传感器
    '''获取机器人周围高度信息(扫描地面网格)'''
    height_scanner= RayCasterCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        offset=RayCasterCfg.OffsetCfg(pos=(0.0, 0.0, 20.0)),
        ray_alignment="yaw",
        pattern_cfg=patterns.GridPatternCfg(resolution=0.1, size=[1.6, 1.0]),
        debug_vis=False,
        mesh_prim_paths=["/World/ground"],
    )
    # 接触传感器
    ''' 检测机器人所有‘Robot’下部件,3单位历史长度下,离开地面的时间 '''
    contact_forces = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/.*",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],   # 只统计与地面接触（精确碰撞体）
    )

    # 传感器组
    # ======== body ============
    base_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )

    # The USD used here does not expose every non-foot contact reporter named
    # by the legacy reward/termination configuration.  Keep those field names
    # stable and bind missing reporters to the base contact sensor.
    trunk_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )

    head_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )


    # ======== hip ============
    FL_hip_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    FR_hip_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )    
    RL_hip_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RR_hip_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )

    # ======== thigh ============
    FL_thigh_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    FR_thigh_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RL_thigh_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RR_thigh_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )

    # ======== calf ============
    FL_calf_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    FR_calf_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RL_calf_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RR_calf_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/base",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
)



    # ======= 足部接触传感器 =======TODO:确认是否是接触传感器的问题
    FL_foot_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/FL_foot",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    FR_foot_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/FR_foot",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RL_foot_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/RL_foot",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
    )
    RR_foot_contact = ContactSensorCfg(
        prim_path="{ENV_REGEX_NS}/Robot/RR_foot",
        history_length=3,
        track_air_time=True,
        filter_prim_paths_expr=["/World/ground/terrain/GroundPlane/CollisionPlane"],
)


    # lights
    sky_light = AssetBaseCfg(
        prim_path="/World/skyLight",
        spawn=sim_utils.DomeLightCfg(
            intensity=750.0,
            texture_file=f"{ISAAC_NUCLEUS_DIR}/Materials/Textures/Skies/PolyHaven/kloofendal_43d_clear_puresky_4k.hdr",
        ),
    )


FOOT_CONTACT_SENSORS = [
    "FL_foot_contact",
    "FR_foot_contact",
    "RL_foot_contact",
    "RR_foot_contact",
]

HARD_BODY_CONTACT_SENSORS = [
    "head_contact",
    "base_contact",
    "trunk_contact",
]

LEG_BODY_CONTACT_SENSORS = [
    "FL_hip_contact", "FR_hip_contact", "RL_hip_contact", "RR_hip_contact",
    "FL_thigh_contact", "FR_thigh_contact", "RL_thigh_contact", "RR_thigh_contact",
    "FL_calf_contact", "FR_calf_contact", "RL_calf_contact", "RR_calf_contact",
]
