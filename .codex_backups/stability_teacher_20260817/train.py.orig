parser.add_argument(
    "--save_interval",
    type=int,
    default=None,
    help="Checkpoint interval in learning iterations.",
)
parser.add_argument(
    "--partial_init_checkpoint",
    type=str,
    default=None,
    help="Initialize shape-compatible policy parameters and overlapping action heads from a checkpoint.",
)
